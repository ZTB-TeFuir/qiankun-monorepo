{
  "name": "qiankun-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Qiankun micro-frontend monorepo with React & Vue sub-apps",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev:main": "pnpm -F main-app dev",
    "dev:sub-react": "pnpm -F sub-react dev",
    "dev:sub-vue": "pnpm -F sub-vue dev",
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "build:main": "pnpm -F main-app build",
    "build:sub-react": "pnpm -F sub-react build",
    "build:sub-vue": "pnpm -F sub-vue build"
  }
}
